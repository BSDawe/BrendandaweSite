---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';

interface Props {
  title?: string;
  description?: string;
}
const { title, description = 'Brendan Dawe: land economics, housing and planning consultant in Vancouver, BC.' } = Astro.props;
const pageTitle = title ? `${title} | Brendan Dawe` : 'Brendan Dawe';
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/cv/', label: 'CV' },
  { href: '/research/', label: 'Research and Analysis' },
  { href: '/contact/', label: 'Contact' },
];
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Brendan Dawe" href="/rss.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://brendandawe.ca/brendan-dawe.jpg" />
    <style is:global>
      :root {
        --bg: #ffffff;
        --fg: #1c1b20;
        --muted: #62606b;
        --accent: #a12f3c;
        --accent-fg: #ffffff;
        --tint: #f9eaec;
        --rule: #ececf0;
        --sans: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
        --serif: 'Source Serif 4 Variable', Georgia, serif;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #16141a; --fg: #eeebef; --muted: #a29fac;
          --accent: #ec8e98; --accent-fg: #1b1115; --tint: #2a1d22; --rule: #2b2831;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--fg);
        font: 17px/1.65 var(--sans);
        border-top: 5px solid var(--accent);
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-underline-offset: 0.18em; }
      header, main, footer { max-width: 46rem; margin: 0 auto; padding: 0 1.25rem; }
      header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 0.5rem 1.5rem; padding-top: 1.5rem; padding-bottom: 1.25rem; }
      .brand { font-weight: 700; font-size: 1.05rem; text-decoration: none; color: var(--fg); letter-spacing: -0.01em; }
      nav { display: flex; gap: 1.25rem; }
      nav a { text-decoration: none; font-weight: 500; font-size: 0.92rem; color: var(--muted); padding-bottom: 0.2rem; border-bottom: 2px solid transparent; }
      nav a:hover { color: var(--fg); }
      nav a[aria-current='page'] { color: var(--fg); border-bottom-color: var(--accent); }
      main { padding-top: 1.5rem; padding-bottom: 3.5rem; }
      h1, h2, h3 { font-family: var(--sans); line-height: 1.2; letter-spacing: -0.02em; }
      h1 { font-size: 2.2rem; font-weight: 750; margin: 0 0 0.5rem; }
      h2 { font-size: 1.2rem; font-weight: 700; margin: 2.4rem 0 0.6rem; }
      h2::before { content: ''; display: inline-block; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--accent); margin-right: 0.55rem; vertical-align: 0.08em; }
      h3 { font-size: 1.02rem; font-weight: 650; }
      .meta, .muted { color: var(--muted); font-size: 0.9rem; line-height: 1.5; }
      .role { margin: 1.2rem 0; }
      .role h3 { margin: 0; }
      .role p { margin: 0.25rem 0 0; }
      ul.posts { list-style: none; padding: 0; }
      ul.posts li { margin: 1.3rem 0; }
      footer { border-top: 1px solid var(--rule); padding-top: 1rem; padding-bottom: 2rem; }

      .button { display: inline-block; padding: 0.6rem 1.15rem; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 0.92rem; line-height: 1.2; background: var(--accent); color: var(--accent-fg); border: 2px solid var(--accent); }
      .button:hover { filter: brightness(1.08); }
      .button.ghost { background: transparent; color: var(--accent); }

      .hero { display: grid; grid-template-columns: 1fr; gap: 1.75rem; justify-items: center; text-align: center; background: var(--tint); border-radius: 18px; padding: 2rem 1.5rem; }
      @media (min-width: 40rem) { .hero { grid-template-columns: 11rem 1fr; justify-items: start; text-align: left; align-items: center; padding: 2.25rem 2.25rem; gap: 2.25rem; } }
      .portrait { width: 11rem; height: 11rem; border-radius: 50%; object-fit: cover; object-position: center; border: 5px solid var(--bg); box-shadow: 0 0 0 3px var(--accent); }
      .tagline { margin: 0 0 1rem; color: var(--accent); font-weight: 600; font-size: 0.95rem; letter-spacing: 0.04em; text-transform: uppercase; }
      .callout { margin: 1.1rem 0; padding: 0.7rem 1rem; background: var(--bg); border-left: 4px solid var(--accent); border-radius: 4px; text-align: left; }
      .buttons { display: flex; flex-wrap: wrap; gap: 0.6rem; }
      @media (max-width: 39.99rem) { .buttons { justify-content: center; } }

      article { font-family: var(--serif); font-size: 1.12rem; line-height: 1.7; }
      article h1, article h2, article h3, article .meta { font-family: var(--sans); }
      article figure { margin: 1.5rem 0; }
      article img { max-width: 100%; height: auto; border-radius: 8px; display: block; }
      article figcaption { margin-top: 0.5rem; font-family: var(--sans); font-size: 0.85rem; line-height: 1.5; color: var(--muted); }
      article li { margin: 0.35rem 0; }
      .note { border-left: 3px solid var(--rule); padding-left: 1rem; color: var(--muted); }
    </style>
  </head>
  <body>
    <header>
      <a class="brand" href="/">Brendan Dawe</a>
      <nav aria-label="Main">
        {nav.map((n) => (
          <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer class="muted">
      © {new Date().getFullYear()} Brendan Dawe · Vancouver, BC · <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>
