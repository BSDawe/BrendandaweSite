---
import Base from '../layouts/Base.astro';
const email = 'brendan@brendandawe.ca';
---
<Base title="Contact" description="Contact Brendan Dawe about consulting engagements or full-time opportunities.">
  <h1>Contact</h1>
  <p>
    I'm available for consulting engagements in land economics, housing and planning, and I'm
    open to contract or full-time roles. The best way to reach me is by email.
  </p>
  <ul>
    <li>Email: <a href={`mailto:${email}`}>{email}</a></li>
    <li>LinkedIn: <a href="https://www.linkedin.com/in/brendan-dawe-24959140" rel="me noopener">linkedin.com/in/brendan-dawe-24959140</a></li>
    <li>Location: Vancouver, BC</li>
  </ul>
</Base>
