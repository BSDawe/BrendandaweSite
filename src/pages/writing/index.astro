---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<Base title="Research and Analysis" description="Research and analysis by Brendan Dawe on housing, transit, development and land economics.">
  <h1>Research and Analysis</h1>
  {posts.length === 0 ? (
    <p class="muted">Posts are coming soon.</p>
  ) : (
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a href={`/writing/${p.id}/`}><strong>{p.data.title}</strong></a><br />
          <span class="meta">{fmt.format(p.data.date)}</span><br />
          <span>{p.data.description}</span>
        </li>
      ))}
    </ul>
  )}
</Base>
