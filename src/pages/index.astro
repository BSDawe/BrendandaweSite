---
import Base from '../layouts/Base.astro';
---
<Base description="Brendan Dawe: land economics, housing and planning consultant in Vancouver, BC. Available for consulting engagements and open to full-time roles.">
  <div class="hero">
    <img class="portrait" src="/brendan-dawe-square.jpg" alt="Brendan Dawe" width="440" height="440" />
    <div>
      <h1>Brendan Dawe</h1>
      <p class="tagline">Land economics · Housing · Planning</p>
      <p>
        I'm a consultant working where land economics, housing policy and planning meet,
        with six years of experience advising local governments, First Nations and landowners
        across Western Canada. I bring an economist's grounding to planning questions: what a
        community needs, what the land can support, and what it will take to get built.
      </p>
      <p class="callout">
        <strong>Available for consulting engagements</strong> and open to joining a team
        on a contract or full-time basis.
      </p>
      <p class="buttons">
        <a class="button" href="/contact/">Get in touch</a>
        <a class="button ghost" href="/cv/">View my CV</a>
      </p>
    </div>
  </div>

  <h2>What I can help with</h2>
  <ul>
    <li>Housing needs assessments and demographic analysis</li>
    <li>Development feasibility and land economics</li>
    <li>First Nations land development</li>
    <li>Real estate strategy and financial analysis</li>
    <li>Clear reporting and presentations to Councils, Boards and clients</li>
  </ul>
</Base>
